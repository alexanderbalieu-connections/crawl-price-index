#!/usr/bin/env node
/**
 * CRAWL PRICE INDEX — HISTORY ARCHIVER  (node archive.cjs)
 * ========================================================
 * After each scan+rebuild, snapshot the key metrics into a dated history file.
 * This is THE moat: the accumulating record no competitor who started later
 * can ever backfill. Every run adds one immutable dated point.
 *
 * Writes:
 *   history/<YYYY-MM-DD>.json   — compact snapshot of that scan's metrics
 *   history-index.json          — rolling index of all snapshot dates + summary
 *
 * Reads: scan-summary.json (+ the country data via paid-dataset.json if present)
 *
 * Idempotent per day: re-running on the same date overwrites that day's point
 * (so a re-scan corrects rather than duplicates).
 */
const fs = require("fs");
const path = require("path");

if (!fs.existsSync("scan-summary.json")) {
  console.error("no scan-summary.json — run a scan+rebuild first");
  process.exit(1);
}
const summary = JSON.parse(fs.readFileSync("scan-summary.json", "utf8"));
const date = new Date(summary.generated_utc || Date.now()).toISOString().slice(0, 10);

// pull country + price detail from the paid dataset if it exists (full fidelity),
// else fall back to whatever summary carries
let country = {}, prices = [], signals = {};
if (fs.existsSync("paid-dataset.json")) {
  const paid = JSON.parse(fs.readFileSync("paid-dataset.json", "utf8"));
  country = paid.country_editions || {};
  prices = paid.observed_prices || [];
  signals = paid.signals || {};
} else if (summary.panel) {
  prices = (summary.panel.prices || []).map(raw => ({ raw }));
  signals = { tollbit_gated: summary.panel.tollbit || [], licensing_402: [], declares_free: summary.panel.paymentHeaders || [] };
}

// extract the flagship price number (highest observed USD/crawl)
let topPrice = null;
for (const p of prices) {
  const m = String(p.raw || "").match(/([\d.]+)/);
  if (m) topPrice = Math.max(topPrice || 0, parseFloat(m[1]));
}

// compact snapshot — small on purpose so years of history stay cheap
const snapshot = {
  date,
  generated_utc: summary.generated_utc,
  coverage: { tranco_top_n: summary.tranco_top_n, robots_parsed: summary.robots_parsed },
  block_rates: Object.fromEntries(Object.entries(summary.block_rates || {}).map(([k, v]) => [k, v.rate_pct])),
  top_observed_price_usd: topPrice,
  signal_counts: {
    tollbit_gated: (signals.tollbit_gated || []).length,
    licensing_402: (signals.licensing_402 || []).length,
    declares_free: (signals.declares_free || []).length,
  },
  country_any_ai: Object.fromEntries(Object.entries(country).map(([c, d]) => [c, d.any_ai])),
};

fs.mkdirSync("history", { recursive: true });

// ---- SAME-DAY GUARD -------------------------------------------------------
// A history point cannot be backfilled, so overwriting one silently is the
// worst failure this project has. Refuse to replace an existing point unless
// it is explicitly asked for:  node archive.cjs --force
const snapPath = path.join("history", date + ".json");
if (fs.existsSync(snapPath) && !process.argv.includes("--force")) {
  console.error("REFUSING to overwrite the existing history point for " + date + ".");
  console.error("A dated point already exists and cannot be reconstructed if lost.");
  console.error("If this really is a corrected re-scan:  node archive.cjs --force");
  process.exit(3);
}
if (fs.existsSync(snapPath)) {
  fs.copyFileSync(snapPath, snapPath + ".replaced-" + Date.now());
  console.log("--force: previous point for " + date + " kept as a .replaced- backup");
}
fs.writeFileSync(path.join("history", `${date}.json`), JSON.stringify(snapshot));

// rebuild the rolling index from all files present
const files = fs.readdirSync("history").filter(f => /^\d{4}-\d{2}-\d{2}\.json$/.test(f)).sort();
const index = {
  first_snapshot: files[0]?.replace(".json", "") || date,
  latest_snapshot: files[files.length - 1]?.replace(".json", "") || date,
  snapshot_count: files.length,
  dates: files.map(f => f.replace(".json", "")),
  note: "Immutable dated history of the crawl economy. Started " + (files[0]?.replace(".json", "") || date) + ". Deltas and trends derive from this; a competitor who started later cannot reconstruct it.",
};
fs.writeFileSync("history-index.json", JSON.stringify(index, null, 2));

console.log(`Archived snapshot ${date}.  History now spans ${index.snapshot_count} point(s): ${index.first_snapshot} → ${index.latest_snapshot}`);
if (index.snapshot_count === 1) console.log("  (First point — the baseline. Every future scan widens the moat.)");
