<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>World editions — The Crawl Price Index</title>
<meta name="description" content="AI-crawler block rates by country. France blocks hardest; Russia barely at all. Updated weekly.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Spline+Sans+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{--ink:#FBFAF8;--panel:#F2EFE9;--line:#DCD7CE;--dim:#6E6A64;--fg:#14181D;--bright:#14181D;--signal:#1C5D4A;--amber:#9C7A2C;--red:#A33A2A}
  *{box-sizing:border-box}
  body{margin:0;background:var(--ink);color:var(--fg);font-family:"Newsreader",Georgia,serif;font-size:18px;line-height:1.55}
  .mono{font-family:"Archivo","Helvetica Neue",Arial,sans-serif}
  .wrap{max-width:920px;margin:0 auto;padding:0 24px}
  header{padding:56px 0 36px;border-bottom:1px solid var(--line)}
  .back{font-family:"Archivo","Helvetica Neue",Arial,sans-serif;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--signal);text-decoration:none}
  .eyebrow{font-family:"Archivo","Helvetica Neue",Arial,sans-serif;font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--dim);margin-top:20px}
  h1{font-size:clamp(32px,5.4vw,54px);font-weight:500;color:var(--bright);margin:.3em 0 .25em;letter-spacing:-.015em}
  h1 em{font-style:italic;color:var(--signal)}
  .lede{font-size:clamp(17px,2.2vw,21px);color:var(--fg);max-width:36em;margin:0}
  .asof{margin-top:20px;font-family:"Archivo","Helvetica Neue",Arial,sans-serif;font-size:12.5px;color:var(--dim)}

  section{padding:48px 0;border-bottom:1px solid var(--line)}
  h2{font-size:clamp(24px,3.4vw,34px);font-weight:500;color:var(--bright);margin:0 0 .5em;letter-spacing:-.01em}
  p.body{max-width:40em;color:var(--fg)}

  /* ranked country bars */
  .rank{display:flex;flex-direction:column;gap:2px;margin-top:10px}
  .row{display:grid;grid-template-columns:150px 1fr 62px;align-items:center;gap:14px;padding:10px 0;border-bottom:1px solid var(--line)}
  .row .c{font-family:"Archivo","Helvetica Neue",Arial,sans-serif;font-size:14px;color:var(--bright);display:flex;align-items:baseline;gap:8px}
  .row .c .n{font-size:11px;color:var(--dim)}
  .track{position:relative;height:22px;background:#F2EFE9;border-radius:2px;overflow:hidden}
  .track>i{position:absolute;left:0;top:0;bottom:0;border-radius:2px}
  .row .pct{font-family:"Archivo","Helvetica Neue",Arial,sans-serif;font-size:15px;color:var(--bright);text-align:right}
  .baseline{display:flex;align-items:center;gap:10px;margin-top:16px;font-family:"Archivo","Helvetica Neue",Arial,sans-serif;font-size:12.5px;color:var(--dim)}
  .baseline .dot{width:10px;height:2px;background:var(--dim);display:inline-block}

  table{width:100%;border-collapse:collapse;font-family:"Archivo","Helvetica Neue",Arial,sans-serif;font-size:13.5px;margin-top:14px}
  th,td{padding:10px 8px;border-bottom:1px solid var(--line);text-align:right}
  th:first-child,td:first-child{text-align:left}
  th{color:var(--dim);font-weight:500;font-size:11px;letter-spacing:.06em;text-transform:uppercase}
  td.c{color:var(--bright)}
  td .n{color:var(--dim);font-size:11px}

  .note{background:var(--panel);border:1px solid var(--line);border-left:2px solid var(--amber);padding:15px 18px;font-size:14.5px;color:var(--fg);margin-top:24px;font-family:"Newsreader",serif;max-width:44em}
  footer{padding:40px 0 70px;color:var(--dim);font-family:"Archivo","Helvetica Neue",Arial,sans-serif;font-size:12px}
  footer a{color:var(--fg)}
  @media(max-width:620px){.row{grid-template-columns:110px 1fr 52px;gap:8px}.row .c{font-size:12px}}
</style>
<link rel="stylesheet" href="/theme.css">
</head>
<body>
<div class="masthead"><div class="wrap">
  <a class="mark" href="/">The Crawl Price Index<b>.</b></a>
  <nav>
    <a class="lnk" href="/check">Check a domain</a>
    <a class="lnk" href="/world" aria-current="page">Country editions</a>
    <a class="lnk" href="/methodology">Methodology</a>
    <a class="ghost" href="/sample">Weekly email</a>
    <a class="btn" href="/#access">Subscribe</a>
  </nav>
</div></div>
<header><div class="wrap">
  <a class="back" href="/">← The Crawl Price Index</a>
  <div class="eyebrow">World editions</div>
  <h1>Where the web is<br>building its <em>toll booth</em>.</h1>
  <p class="lede">AI-crawler blocking is not global — it's national. The same scan shows France gating most of its web from AI, while Russia leaves it wide open. Here is the map, by country, refreshed weekly.</p>
  <div class="asof">Baseline · <span id="asof">—</span> · Tranco top 2,000, segmented by country-code domain</div>
</div></header>

<section>
  <div class="wrap">
    <div class="mono" style="font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--dim);margin-bottom:8px">Share of sites blocking at least one AI crawler</div>
    <h2>France leads. Russia opts out of opting out.</h2>
    <div class="rank" id="rank"></div>
    <div class="baseline"><span class="dot"></span> Global baseline (.com/.org and other generic domains): <b id="gtld" style="color:var(--fg)">—</b></div>
    <div class="note" id="note">—</div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="mono" style="font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--dim);margin-bottom:8px">Per-crawler detail</div>
    <h2>Who each country locks out.</h2>
    <p class="body">Block rates by individual crawler tell a sharper story than the headline: some countries gate training bots while leaving search crawlers alone, others block everything or nothing.</p>
    <table id="detail">
      <thead><tr><th>Country</th><th>GPTBot</th><th>ClaudeBot</th><th>Google-Ext.</th><th>Any AI</th></tr></thead>
      <tbody></tbody>
    </table>
  </div>
</section>

<footer><div class="wrap">
  THE CRAWL PRICE INDEX · World editions v1 · <a href="/methodology.html">methodology</a> · <a href="/index.json">data feed</a> · <a href="/">← index</a>
</div></footer>

<script id="data" type="application/json">{"asof":"09 Aug 2026","gtld_baseline":19.1,"rows":[{"country":"Norway","n":54,"any":37,"gpt":27.8,"claude":33.3,"ge":29.6},{"country":"Ireland","n":36,"any":36.1,"gpt":33.3,"claude":27.8,"ge":16.7},{"country":"Portugal","n":46,"any":34.8,"gpt":32.6,"claude":19.6,"ge":26.1},{"country":"New Zealand","n":32,"any":34.4,"gpt":25,"claude":21.9,"ge":21.9},{"country":"South Korea","n":73,"any":32.9,"gpt":24.7,"claude":19.2,"ge":13.7},{"country":"South Africa","n":54,"any":31.5,"gpt":24.1,"claude":22.2,"ge":18.5},{"country":"France","n":322,"any":30.4,"gpt":21.4,"claude":18.6,"ge":19.9},{"country":"Germany","n":768,"any":29.8,"gpt":23.4,"claude":19.9,"ge":17.7},{"country":"Netherlands","n":190,"any":28.9,"gpt":25.3,"claude":21.1,"ge":20.5},{"country":"United Kingdom","n":430,"any":28.6,"gpt":22.8,"claude":21.9,"ge":13.3},{"country":"Denmark","n":46,"any":28.3,"gpt":26.1,"claude":13,"ge":19.6},{"country":"Australia","n":139,"any":28.1,"gpt":18.7,"claude":12.2,"ge":16.5},{"country":"Switzerland","n":96,"any":28.1,"gpt":21.9,"claude":22.9,"ge":19.8},{"country":"Slovakia","n":43,"any":27.9,"gpt":20.9,"claude":14,"ge":18.6},{"country":"Finland","n":62,"any":27.4,"gpt":22.6,"claude":22.6,"ge":22.6},{"country":"Italy","n":230,"any":26.5,"gpt":17.4,"claude":18.7,"ge":15.7},{"country":"Belgium","n":88,"any":26.1,"gpt":23.9,"claude":21.6,"ge":20.5},{"country":"Austria","n":77,"any":26,"gpt":20.8,"claude":20.8,"ge":13},{"country":"Poland","n":239,"any":25.1,"gpt":17.6,"claude":10.9,"ge":9.6},{"country":"Egypt","n":12,"any":25,"gpt":16.7,"claude":16.7,"ge":16.7},{"country":"Spain","n":159,"any":24.5,"gpt":20.1,"claude":16.4,"ge":9.4},{"country":"Philippines","n":29,"any":24.1,"gpt":24.1,"claude":13.8,"ge":13.8},{"country":"Czechia","n":129,"any":22.5,"gpt":15.5,"claude":15.5,"ge":14},{"country":"Mexico","n":63,"any":22.2,"gpt":15.9,"claude":11.1,"ge":12.7},{"country":"Colombia","n":209,"any":21.5,"gpt":18.2,"claude":14.8,"ge":13.9},{"country":"Japan","n":322,"any":21.4,"gpt":15.2,"claude":14.3,"ge":13},{"country":"Taiwan","n":43,"any":20.9,"gpt":18.6,"claude":20.9,"ge":16.3},{"country":"Malaysia","n":40,"any":20,"gpt":17.5,"claude":17.5,"ge":17.5},{"country":"India","n":171,"any":19.9,"gpt":14,"claude":13.5,"ge":13.5},{"country":"Greece","n":70,"any":18.6,"gpt":12.9,"claude":11.4,"ge":10},{"country":"Turkey","n":99,"any":18.2,"gpt":11.1,"claude":12.1,"ge":5.1},{"country":"Bulgaria","n":29,"any":17.2,"gpt":13.8,"claude":10.3,"ge":10.3},{"country":"Sweden","n":100,"any":17,"gpt":14,"claude":16,"ge":15},{"country":"Argentina","n":56,"any":16.1,"gpt":8.9,"claude":5.4,"ge":5.4},{"country":"Singapore","n":32,"any":15.6,"gpt":12.5,"claude":9.4,"ge":9.4},{"country":"Israel","n":26,"any":15.4,"gpt":11.5,"claude":11.5,"ge":11.5},{"country":"Indonesia","n":99,"any":15.2,"gpt":13.1,"claude":12.1,"ge":8.1},{"country":"Romania","n":67,"any":14.9,"gpt":7.5,"claude":6,"ge":4.5},{"country":"Brazil","n":289,"any":14.5,"gpt":11.4,"claude":9,"ge":8.7},{"country":"Thailand","n":23,"any":13,"gpt":4.3,"claude":4.3,"ge":4.3},{"country":"Canada","n":150,"any":12.7,"gpt":10.7,"claude":8,"ge":6.7},{"country":"Hungary","n":71,"any":12.7,"gpt":12.7,"claude":7,"ge":9.9},{"country":"Hong Kong","n":24,"any":12.5,"gpt":8.3,"claude":4.2,"ge":4.2},{"country":"Ukraine","n":99,"any":12.1,"gpt":5.1,"claude":6.1,"ge":4},{"country":"Saudi Arabia","n":17,"any":11.8,"gpt":11.8,"claude":11.8,"ge":11.8},{"country":"Vietnam","n":86,"any":11.6,"gpt":8.1,"claude":9.3,"ge":8.1},{"country":"Chile","n":44,"any":11.4,"gpt":9.1,"claude":6.8,"ge":4.5},{"country":"Croatia","n":19,"any":10.5,"gpt":5.3,"claude":5.3,"ge":5.3},{"country":"UAE","n":12,"any":8.3,"gpt":8.3,"claude":8.3,"ge":8.3},{"country":"Russia","n":1048,"any":8.1,"gpt":5.4,"claude":2.5,"ge":1.6},{"country":"Iran","n":68,"any":4.4,"gpt":2.9,"claude":2.9,"ge":2.9},{"country":"China","n":118,"any":3.4,"gpt":2.5,"claude":1.7,"ge":0.8},{"country":"Serbia","n":23,"any":0,"gpt":0,"claude":0,"ge":0}],"note":"Directional. Samples are ccTLD domains carrying robots.txt within the Tranco top-N (n shown per country). Larger scans enlarge every sample."}</script>
<script>
  const D = JSON.parse(document.getElementById('data').textContent);
  const $=(s)=>document.querySelector(s);
  $('#asof').textContent = D.asof;
  $('#gtld').textContent = D.gtld_baseline + '%';
  $('#note').textContent = D.note;

  const color=(v)=> v>=50?'var(--red)': v>=25?'var(--amber)':'var(--signal)';
  const max=Math.max(...D.rows.map(r=>r.any));
  const FREE=3; // free preview: top-blocking country + 2 more; rest is gated
  const free = D.rows.slice(0,FREE), locked = D.rows.length - FREE;

  // ranked bars: free ones shown, remainder collapsed into a locked teaser
  $('#rank').innerHTML = free.map(r=>`
    <div class="row">
      <div class="c">${r.country}<span class="n">n=${r.n}</span></div>
      <div class="track"><i style="width:${(r.any/max*100).toFixed(0)}%;background:${color(r.any)}"></i></div>
      <div class="pct">${r.any}%</div>
    </div>`).join('') + (locked>0 ? `
    <div class="row" style="opacity:.55;filter:blur(.4px)">
      <div class="c">+ ${locked} more countries<span class="n">locked</span></div>
      <div class="track"><i style="width:40%;background:var(--dim)"></i></div>
      <div class="pct">••</div>
    </div>
    <div style="margin-top:16px;padding:16px 18px;border:1px solid var(--line);border-left:2px solid var(--signal);background:var(--panel);border-radius:2px">
      <div style="font-family:'Archivo','Helvetica Neue',Arial,sans-serif;font-size:13px;color:var(--bright);margin-bottom:6px">🔒 Full country index is a Terminal feature</div>
      <div style="font-size:14px;color:var(--fg);max-width:44em">All ${D.rows.length} countries, the per-crawler breakdown, and weekly history are part of the Terminal subscription. Free tier shows the top ${FREE}.
      <a href="/#access" style="color:var(--signal);text-decoration:none;border-bottom:1px solid rgba(60,240,138,.35)">See Terminal access →</a></div>
    </div>` : '');

  // per-crawler detail table: free rows shown, then a locked overlay row
  $('#detail tbody').innerHTML = free.map(r=>`
    <tr><td class="c">${r.country} <span class="n">n=${r.n}</span></td>
    <td>${r.gpt}%</td><td>${r.claude}%</td><td>${r.ge}%</td><td>${r.any}%</td></tr>`).join('')
    + (locked>0 ? `<tr style="opacity:.5"><td class="c">+ ${locked} more <span class="n">Terminal</span></td>
    <td>••</td><td>••</td><td>••</td><td>••</td></tr>` : '');
</script>
</body>
</html>
