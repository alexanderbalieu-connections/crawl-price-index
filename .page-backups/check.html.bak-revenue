<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Your domain&rsquo;s AI-access profile — The Crawl Price Index</title>
<meta name="description" content="Free tool: enter a domain to see its declared AI-crawler policy across 18 tracked crawlers, and how that compares with the domains in this week&rsquo;s scanned panel. A measurement, not a valuation.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 32 32%27%3E%3Crect width=%2732%27 height=%2732%27 fill=%27%23FBFAF8%27/%3E%3Crect x=%276%27 y=%2714%27 width=%2720%27 height=%274%27 fill=%27%231C5D4A%27/%3E%3C/svg%3E">
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,300&family=Archivo:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  *{box-sizing:border-box}
  body{margin:0;background:var(--ink);color:var(--fg);font-family:"Newsreader",Georgia,serif;font-size:17px;line-height:1.55}
  a{color:var(--signal)}
  .card{background:var(--panel);border:1px solid var(--line);padding:22px;margin:26px 0}
  .row{display:flex;gap:10px;flex-wrap:wrap}
  input[type=text]{flex:1;min-width:220px;background:var(--ink);border:1px solid var(--line);color:var(--fg);font-family:"Spline Sans Mono",monospace;font-size:15px;padding:14px 14px;outline:none}
  input[type=text]:focus{border-color:var(--signal)}
  .go:disabled{opacity:.5;cursor:wait}
  .k{font-family:"Spline Sans Mono",monospace;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--dim);margin:0 0 10px}
  .msg{font-family:"Spline Sans Mono",monospace;font-size:12.5px;color:var(--dim);margin-top:10px;min-height:1.2em}
  /* fingerprint grid */
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:1px;background:var(--line);border:1px solid var(--line)}
  .cell{background:var(--ink);padding:10px 10px 9px}
  .cell .b{font-family:"Spline Sans Mono",monospace;font-size:11.5px;color:var(--bright);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .cell .v{font-family:"Spline Sans Mono",monospace;font-size:11px;margin-top:3px}
  .v-blocked{color:var(--red)}.v-allowed{color:var(--signal)}.v-partial{color:var(--amber)}.v-unlisted{color:var(--dim)}.v-none{color:#4a5457}
  .statline{display:flex;gap:26px;flex-wrap:wrap;margin:16px 0 4px}
  .stat .n{font-family:"Spline Sans Mono",monospace;font-size:30px;color:var(--bright)}
  .stat .n.g{color:var(--signal)}
  .stat .l{font-size:13px;color:var(--dim)}
  .bar{height:8px;background:#1a1f22;border-radius:2px;margin-top:14px;position:relative}
  .bar i{position:absolute;left:0;top:0;bottom:0;background:var(--signal);border-radius:2px}
  .bar b{position:absolute;top:-4px;width:2px;height:16px;background:var(--bright)}
  /* estimator */
  label{display:block;font-family:"Spline Sans Mono",monospace;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--dim);margin:16px 0 6px}
  select{width:100%;background:var(--ink);border:1px solid var(--line);color:var(--fg);font-family:"Spline Sans Mono",monospace;font-size:13.5px;padding:11px 10px;outline:none}
  select:focus{border-color:var(--signal)}
  .cols{display:grid;grid-template-columns:1fr 1fr;gap:18px}
  @media(max-width:640px){.cols{grid-template-columns:1fr}}
  input[type=range]{width:100%;accent-color:var(--signal);margin-top:6px}
  .price{font-family:"Spline Sans Mono",monospace;font-size:26px;color:var(--bright);margin-top:2px}
  .band{font-family:"Spline Sans Mono",monospace;font-size:12px;color:var(--dim)}
  .band em{color:var(--signal);font-style:normal}
  .scen{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line);border:1px solid var(--line);margin-top:18px}
  @media(max-width:640px){.scen{grid-template-columns:1fr}}
  .sc{background:var(--ink);padding:16px}
  .sc .t{font-family:"Spline Sans Mono",monospace;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--dim)}
  .sc .m{font-family:"Spline Sans Mono",monospace;font-size:28px;margin-top:6px;color:var(--bright)}
  .sc .m.g{color:var(--signal)}
  .sc .d{font-size:13px;color:var(--dim);margin-top:6px;line-height:1.45}
  .truth{border-left:3px solid var(--amber);background:#15130d;padding:12px 14px;font-size:14px;color:#e8dcc0;margin-top:16px;line-height:1.5}
  /* artifacts */
  pre{background:var(--ink);border:1px solid var(--line);padding:14px;overflow:auto;font-family:"Spline Sans Mono",monospace;font-size:12px;line-height:1.5;color:var(--fg);margin:8px 0 0}
  .art{margin-top:22px}
  .art .head{display:flex;align-items:center;justify-content:space-between;gap:10px}
  .steps{font-size:15.5px;line-height:1.65;margin:8px 0 0;padding-left:20px}
  .steps li{margin-bottom:8px}
  footer{padding:34px 0 50px;font-family:"Spline Sans Mono",monospace;font-size:12px;color:var(--dim)}
  .hide{display:none}
  ::selection{background:var(--signal);color:#000}
  @media (prefers-reduced-motion: no-preference){
    .card{animation:up .35s ease both}
    @keyframes up{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
  }
</style>
<link rel="stylesheet" href="/theme.css">
</head>
<body>
<div class="masthead"><div class="wrap">
  <a class="mark" href="/">The Crawl Price Index<b>.</b></a>
  <nav class="navmid">
    <a class="lnk" href="/why">Why it matters</a>
    <a class="lnk on" aria-current="page" href="/check">Check a domain</a>
    <a class="lnk" href="/explore">Explore data</a>
    <a class="lnk" href="/methodology">Method</a>
  </nav>
  <div class="navend">
    <a class="lnk signin" href="https://app.crawlpriceindex.com">Sign in</a>
    <a class="btn" href="https://app.crawlpriceindex.com/dashboard.html#account">Full dataset &mdash; &euro;49/mo</a>
  </div>
</div></div>
<div class="page-open"><div class="wrap">
  <p class="eyebrow">Free tool</p>
  <h1>Your domain&rsquo;s <em>AI-access</em> profile.</h1>
  <p class="lede">Enter a domain. We show what it <b>declares</b> to 18 tracked AI crawlers in its robots.txt, and how that compares with the domains in this week&rsquo;s scanned panel. This is a measurement of declared policy &mdash; not a valuation, a recommendation, or a forecast. No signup needed.</p>
  <div class="meta" id="topmeta">checking index…</div>
</div></div>

<div class="wrap">
  <div class="card">
    <div class="k">Step 1 · your domain</div>
    <div class="row">
      <span class="ac-wrap"><input type="text" id="dom" placeholder="example.com" autocomplete="off" spellcheck="false" inputmode="url"><div class="ac" id="ac" role="listbox"></div></span>
      <button class="go" id="check">Check →</button>
    </div>
    <div class="msg" id="cmsg"></div>
  </div>

  <div class="card hide" id="fp">
    <div class="k">Your AI-crawler policy fingerprint · <span id="fpdom"></span></div>
    <div class="grid" id="fpgrid"></div>
    <div class="statline">
      <div class="stat"><div class="n" id="blocked">—</div><div class="l">of <span id="nbots">18</span> tracked crawlers blocked in robots.txt</div></div>
      <div class="stat"><div class="n g" id="pct">—</div><div class="l">of the scanned web blocks fewer crawlers than you</div></div>
      <div class="stat" id="rankwrap"><div class="n" id="rank">—</div><div class="l">Tranco rank</div></div>
    </div>
    <div class="bar"><i id="barfill" style="width:0%"></i><b id="barme" style="left:0%"></b></div>
    <div class="msg" id="fpnote"></div>
  </div>

  <div class="card" id="est">
    <div class="k">Step 2 · the honest revenue estimate</div>
    <div class="cols">
      <div>
        <label for="visits">Monthly human visits</label>
        <select id="visits">
          <option value="5000">under 10 k</option>
          <option value="30000">10 k – 50 k</option>
          <option value="100000" selected>50 k – 250 k</option>
          <option value="500000">250 k – 1 M</option>
          <option value="2500000">1 M – 5 M</option>
          <option value="10000000">over 5 M</option>
        </select>
        <label for="ctype">Your content type <span style="text-transform:none;letter-spacing:0">(your call — we do not detect this)</span></label>
        <select id="ctype">
          <option value="" selected>Choose one…</option>
          <option value="1.0">News / journalism</option>
          <option value="0.85">Reference / how-to / docs</option>
          <option value="0.7">Technical / niche expertise</option>
          <option value="0.5">Blog / personal</option>
          <option value="0.35">Commerce / listings</option>
        </select>
      </div>
      <div>
        <label for="pr">Your price per crawl</label>
        <div class="price">$<span id="prval">0.02</span></div>
        <input type="range" id="pr" min="0" max="16" step="1" value="6">
        <div class="band" id="bandnote">Suggested band for your tier: <em id="bandtxt">—</em> — our judgment, anchored to the highest price we actually observe anyone charging: <em>$0.50 / crawl</em> (stackoverflow.com → ClaudeBot, reproduced weekly).</div>
      </div>
    </div>
    <div class="scen">
      <div class="sc">
        <div class="t">Today · few buyers actually pay</div>
        <div class="m" id="now">$0 – $0</div>
        <div class="d">Assumes 0.5–2 % of AI crawl requests come from crawlers that pay at posted rates. That share is honest: even on the largest bot-paywall network, roughly 4 in 5 sites have never earned a dollar.</div>
      </div>
      <div class="sc">
        <div class="t">If agentic payments mature</div>
        <div class="m g" id="future">$0</div>
        <div class="d">Assumes 20 % of AI requests pay — the scenario Cloudflare's default-block era (from Sept 15, 2026) is pushing the market toward. Not a promise. A ceiling worth positioning for now, while setup costs you an afternoon.</div>
      </div>
    </div>
    <div class="truth" id="truthline"><b>What is measured vs. what you chose:</b> your policy fingerprint, percentile and rank are measured by our own crawler this week. The revenue figures are an estimate built from the traffic and content type <em>you</em> selected — we do not measure your traffic. Where the ratios come from: publisher networks measured ~1 AI crawler visit per 31 human visits in Q4 2025 (up 60 % in six months); we scale that by your content type. Most tools inflate this. We track the crawl economy for a living — the honest answer is that today's revenue is small for almost everyone, and the option value of being set up early is the real prize.</div>
  </div>

  <div class="card hide" id="watch">
    <div class="k">Step 3 · get told when this changes</div>
    <p style="margin:0 0 4px;font-size:16px">AI-crawler policy is not static — domains flip between blocked and allowed every week. We scan the whole top 50,000 weekly. If anything changes for <span class="mono" id="wdom">your domain</span>, you get one email naming exactly what changed. Nothing else.</p>
    <form id="wa-form" style="margin-top:12px">
      <div class="row">
        <input type="text" id="wa-email" placeholder="you@company.com" autocomplete="email">
        <button class="go" type="submit">Watch this domain →</button>
      </div>
      <div class="msg" id="wa-msg"></div>
    </form>
  </div>

  <div class="card" id="setup">
    <div class="k">Step 3 · start charging in one afternoon</div>
    <ol class="steps">
      <li><b>If you're on Cloudflare</b> (about 1 in 5 sites are): enable <a href="https://developers.cloudflare.com/ai-crawl-control/" rel="noopener">AI Crawl Control</a>, join the Pay Per Crawl beta, and set your price — <span class="mono">minimum $0.01, one price for all charged crawlers</span>. Cloudflare collects and pays out; you never touch the plumbing.</li>
      <li><b>If you're a publisher with real bot traffic</b>: <a href="https://tollbit.com" rel="noopener">TollBit</a> runs a bot paywall on ~7,000 sites — you keep 100 % of your posted rate; AI buyers pay TollBit's fee on top.</li>
      <li><b>Everyone</b>: declare machine-readable terms with <a href="https://rslstandard.org" rel="noopener">RSL</a> and robots.txt so your price and policy are visible to every compliant crawler. Paste the two files below — generated for <span class="mono" id="setdom">your domain</span> at your chosen price.</li>
    </ol>

    <div class="art">
      <div class="head"><div class="k" style="margin:0">robots.txt — add these lines</div><button class="ghost" data-copy="robotsout">Copy</button></div>
      <pre id="robotsout"></pre>
    </div>
    <div class="art">
      <div class="head"><div class="k" style="margin:0">rsl.xml — save at your site root, licence terms machines can read</div><button class="ghost" data-copy="rslout">Copy</button></div>
      <pre id="rslout"></pre>
    </div>
  </div>

  <div class="card">
    <div class="k">Get your numbers weekly</div>
    <p style="margin:0 0 4px;font-size:16px">Your fingerprint and the benchmarks above move every week as the web repricess itself. The Weekly Crawl delivers the movers — which domains changed policy, block-rate shifts, observed prices — plus an instant free data sample.</p>
    <form id="wk" class="row" style="margin-top:12px">
      <input type="text" id="wkmail" placeholder="you@company.com" autocomplete="email">
      <button class="go" type="submit">Get it free →</button>
    </form>
    <div class="msg" id="wkmsg"></div>
    <div class="msg" style="margin-top:2px">Want every domain's row, 53 country editions and the API? <a href="https://app.crawlpriceindex.com/dashboard.html#account">Terminal — €49/mo</a>.</div>
  </div>
</div>

<footer><div class="wrap">THE CRAWL PRICE INDEX · an independent observatory of the machine-readable web · <a href="/methodology.html">methodology</a> · benchmarks refresh weekly from our own signed crawler · this page stores nothing about you</div></footer>

<script>
(function(){
  "use strict";
  var API = "https://api.crawlpriceindex.com";
  var PRICES = [0.005,0.0075,0.01,0.0125,0.015,0.0175,0.02,0.03,0.04,0.05,0.075,0.10,0.15,0.25,0.50,0.75,1.00];
  var ctx = null, state = { domain:"", rank:null, found:false };

  function $(id){ return document.getElementById(id); }
  function fmt(n){ return n>=1000 ? "$"+Math.round(n).toLocaleString() : (n>=100 ? "$"+n.toFixed(0) : "$"+n.toFixed(2)); }
  function vword(c){ return {b:"blocked",a:"allowed",p:"partial",u:"unlisted",n:"no robots.txt"}[c] || c; }
  function vclass(c){ return {b:"v-blocked",a:"v-allowed",p:"v-partial",u:"v-unlisted",n:"v-none"}[c] || "v-unlisted"; }

  // context (aggregates) loads immediately so the page is useful before any input
  fetch(API + "/v1/check?domain=context").then(function(r){return r.json();}).then(function(j){
    ctx = j.context || null;
    if (ctx) $("topmeta").textContent = "Live against " + Number(ctx.robots_parsed).toLocaleString() + " domains parsed this week · Tranco top " + Number(ctx.tranco_top_n).toLocaleString() + " · updated " + (ctx.generated_utc||"").slice(0,10);
    else $("topmeta").textContent = "benchmark data loads per lookup";
  }).catch(function(){ $("topmeta").textContent = "benchmark service warming up — lookups still work"; });

  function tierBand(rank){
    if (rank && rank <= 1000) return { lo:0.25, hi:1.00, txt:"$0.25 – $1.00 / crawl (top-1k property)" , def:14 };
    if (rank && rank <= 10000) return { lo:0.05, hi:0.25, txt:"$0.05 – $0.25 / crawl (top-10k)", def:9 };
    if (rank && rank <= 50000) return { lo:0.01, hi:0.05, txt:"$0.01 – $0.05 / crawl (top-50k)", def:6 };
    return { lo:0.005, hi:0.02, txt:"$0.005 – $0.02 / crawl (long tail — price for the future, not this month)", def:3 };
  }

  function recompute(){
    var visits = +($("visits").value), factor = parseFloat($("ctype").value);
    if (!(factor > 0)) {
      $("now").textContent = "—"; $("future").textContent = "—";
      $("prval").textContent = (PRICES[+$("pr").value] < 0.1 ? PRICES[+$("pr").value].toFixed(3) : PRICES[+$("pr").value].toFixed(2));
      renderArtifacts(PRICES[+$("pr").value]);
      return;
    }
    var price = PRICES[+$("pr").value];
    $("prval").textContent = price < 0.01 ? price.toFixed(4) : (price < 0.1 ? price.toFixed(3) : price.toFixed(2));
    var reqs = (visits / 31) * factor;                    // TollBit Q4'25 panel ratio, scaled by content type
    var nowLo = reqs * 0.005 * price, nowHi = reqs * 0.02 * price;
    var fut = reqs * 0.20 * price;
    $("now").textContent = fmt(nowLo) + " – " + fmt(nowHi) + " /mo";
    $("future").textContent = fmt(fut) + " /mo";
    renderArtifacts(price);
  }

  function renderArtifacts(price){
    var d = state.domain || "example.com";
    $("setdom").textContent = d;
    $("robotsout").textContent =
"# AI training & data crawlers — blocked unless licensed (see License link)\n" +
"User-agent: GPTBot\nDisallow: /\n\nUser-agent: ClaudeBot\nDisallow: /\n\nUser-agent: CCBot\nDisallow: /\n\nUser-agent: Bytespider\nDisallow: /\n\nUser-agent: Google-Extended\nDisallow: /\n\nUser-agent: meta-externalagent\nDisallow: /\n\n" +
"# Search crawlers remain welcome\nUser-agent: Googlebot\nAllow: /\n\nUser-agent: Bingbot\nAllow: /\n\n" +
"License: https://" + d + "/rsl.xml";
    $("rslout").textContent =
'<?xml version="1.0" encoding="UTF-8"?>\n' +
'<rsl xmlns="https://rslstandard.org/rsl">\n' +
'  <content url="/">\n' +
'    <license>\n' +
'      <permits type="usage">ai-use</permits>\n' +
'      <payment type="per-crawl">\n' +
'        <amount currency="USD">' + price.toFixed(2) + '</amount>\n' +
'        <custom>https://' + d + '/contact</custom>\n' +
'      </payment>\n' +
'    </license>\n' +
'  </content>\n' +
'</rsl>\n' +
'<!-- benchmark: crawlpriceindex.com/check -->';
  }

  function renderFingerprint(j){
    document.getElementById("watch").classList.remove("hide");
    document.getElementById("wdom").textContent = j.domain;
    $("fp").classList.remove("hide");
    $("fpdom").textContent = j.domain;
    var g = $("fpgrid"); g.innerHTML = "";
    var bots = (ctx && ctx.bots) || Object.keys(j.stances || {});
    var blocked = 0, any = false;
    bots.forEach(function(b){
      var c = (j.stances && j.stances[b]) || "u";
      if (c === "b") blocked++;
      if (c !== "n") any = true;
      var el = document.createElement("div"); el.className = "cell";
      el.innerHTML = '<div class="b">' + b + '</div><div class="v ' + vclass(c) + '">' + vword(c) + '</div>';
      g.appendChild(el);
    });
    $("nbots").textContent = bots.length;
    $("blocked").textContent = blocked;
    var pct = (j.percentile == null ? null : Math.round(j.percentile));
    $("pct").textContent = pct == null ? "—" : pct + "%";
    if (pct != null){ $("barfill").style.width = pct + "%"; $("barme").style.left = pct + "%"; }
    if (j.rank){ $("rank").textContent = "#" + Number(j.rank).toLocaleString(); $("rankwrap").style.display = ""; }
    else { $("rankwrap").style.display = "none"; }
    $("fpnote").textContent = !any
      ? "No robots.txt was found on your site in this week's scan — every AI crawler currently reads you for free, silently. The files in Step 3 fix that in minutes."
      : (blocked === 0 ? "You block nothing today. That is a choice — but make it a priced choice." : "");
    var band = tierBand(j.rank);
    $("bandtxt").textContent = band.txt;
    $("pr").value = band.def;
    recompute();
  }

  function check(){
    var raw = $("dom").value.trim().toLowerCase();
    raw = raw.replace(/^https?:\/\//,"").replace(/\/.*$/,"").replace(/:.*$/,"");
    if (!/^[a-z0-9.-]{3,253}$/.test(raw) || raw.indexOf(".") < 0){ $("cmsg").textContent = "Enter a bare domain, like example.com"; return; }
    state.domain = raw;
    $("check").disabled = true; $("cmsg").textContent = "checking " + raw + " against this week's scan…";
    fetch(API + "/v1/check?domain=" + encodeURIComponent(raw)).then(function(r){return r.json();}).then(function(j){
      if (j.context && !ctx){ ctx = j.context; }
      if (j.found){
        state.rank = j.rank || null;
        $("cmsg").innerHTML = '<span class="ok">\u2713 Found in this week\u2019s index\u2014scanned ' +
          ((j.context && j.context.asof) || (ctx && ctx.asof) || "this week") + '</span>';
        renderFingerprint(j);
      } else {
        state.rank = null;
        $("cmsg").textContent = raw + " isn't in the Tranco top 50,000 we scan weekly — estimate below uses your inputs instead. (Long-tail truth: the numbers are small. Set up anyway; it's free and the market is moving your way.)";
        $("fp").classList.add("hide");
        var band = tierBand(null);
        $("bandtxt").textContent = band.txt; $("pr").value = band.def;
        recompute();
      }
      var _t = document.getElementById("fp");
      if (!_t || _t.classList.contains("hide")) _t = document.getElementById("est");
      var _y = _t.getBoundingClientRect().top + window.pageYOffset - 16;
      window.scrollTo({ top: _y, behavior: "smooth" });
    }).catch(function(){ $("cmsg").textContent = "Lookup unavailable right now — the estimator below still works."; })
      .finally(function(){ $("check").disabled = false; });
  }

  $("check").addEventListener("click", check);
  $("dom").addEventListener("keydown", function(e){ if (e.key === "Enter") check(); });
  ["visits","ctype"].forEach(function(id){ $(id).addEventListener("change", recompute); });
  $("pr").addEventListener("input", recompute);

  document.querySelectorAll("[data-copy]").forEach(function(btn){
    btn.addEventListener("click", function(){
      var t = $(btn.getAttribute("data-copy")).textContent;
      navigator.clipboard.writeText(t).then(function(){ btn.textContent = "Copied"; setTimeout(function(){ btn.textContent = "Copy"; }, 1400); });
    });
  });

  $("wa-form").addEventListener("submit", function(e){
    e.preventDefault();
    var email = $("wa-email").value.trim();
    if (!email || !state.domain) return;
    $("wa-msg").textContent = "sending…";
    fetch(API + '/v1/watch', { method:'POST', headers:{ 'Content-Type':'application/json' },
      body: JSON.stringify({ email: email, domain: state.domain }) })
      .then(function(r){ return r.json(); })
      .then(function(j){ $("wa-msg").textContent = j.message || j.error || 'something went wrong'; })
      .catch(function(){ $("wa-msg").textContent = 'network error — try again'; });
  });

  $("wk").addEventListener("submit", function(e){
    e.preventDefault();
    var email = $("wkmail").value.trim();
    if (!email) return;
    $("wkmsg").textContent = "sending…";
    fetch(API + "/v1/subscribe", { method:"POST", headers:{ "Content-Type":"application/json" }, body: JSON.stringify({ email: email }) })
      .then(function(r){return r.json();}).then(function(j){ $("wkmsg").textContent = j.message || j.error || "something went wrong"; })
      .catch(function(){ $("wkmsg").textContent = "network error — try again"; });
  });

  renderArtifacts(PRICES[6]);
  recompute();
})();

  /* cpi-suggest — type-ahead over the indexed domain list */
  (function(){
    var input = document.getElementById("dom"), box = document.getElementById("ac");
    if (!input || !box) return;
    var list = null, loading = false, items = [], sel = -1;

    function load(){
      if (list || loading) return;
      loading = true;
      fetch("/suggest.txt").then(function(r){ return r.ok ? r.text() : ""; })
        .then(function(t){ list = t ? t.split("\n").filter(Boolean) : []; render(); })
        .catch(function(){ list = []; });
    }
    function close(){ box.classList.remove("open"); box.innerHTML = ""; items = []; sel = -1; }
    function choose(v){ input.value = v; close(); var b = document.getElementById("check"); if (b) b.click(); }

    function render(){
      var q = input.value.trim().toLowerCase().replace(/^https?:\/\//,"").replace(/\/.*$/,"");
      if (!list || q.length < 2){ close(); return; }
      var pre = [], sub = [];
      for (var i = 0; i < list.length && pre.length + sub.length < 400; i++){
        var d = list[i];
        if (d.indexOf(q) === 0) pre.push(d);
        else if (d.indexOf(q) > -1) sub.push(d);
      }
      items = pre.concat(sub).slice(0, 8);
      if (!items.length){ close(); return; }
      box.innerHTML = items.map(function(d, i){
        return '<button type="button" role="option" data-i="' + i + '">' + d +
               '<span class="rk">#' + (list.indexOf(d) + 1) + '</span></button>';
      }).join("");
      box.classList.add("open");
      sel = -1;
    }

    input.addEventListener("focus", load);
    input.addEventListener("input", function(){ load(); render(); });
    input.addEventListener("keydown", function(e){
      if (!box.classList.contains("open")) return;
      var btns = box.querySelectorAll("button");
      if (e.key === "ArrowDown" || e.key === "ArrowUp"){
        e.preventDefault();
        sel += (e.key === "ArrowDown" ? 1 : -1);
        if (sel < 0) sel = btns.length - 1;
        if (sel >= btns.length) sel = 0;
        btns.forEach(function(b){ b.classList.remove("sel"); });
        if (btns[sel]){ btns[sel].classList.add("sel"); btns[sel].scrollIntoView({block:"nearest"}); }
      } else if (e.key === "Enter" && sel > -1){
        e.preventDefault(); choose(items[sel]);
      } else if (e.key === "Escape"){ close(); }
    });
    box.addEventListener("click", function(e){
      var b = e.target.closest("button"); if (b) choose(items[+b.getAttribute("data-i")]);
    });
    document.addEventListener("click", function(e){
      if (!box.contains(e.target) && e.target !== input) close();
    });
  })();
</script>
</body>
</html>
