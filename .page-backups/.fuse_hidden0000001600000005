<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Your free sample — The Crawl Price Index</title>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,300&family=Archivo:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  *{box-sizing:border-box}
  body{margin:0;background:var(--ink);color:var(--fg);font-family:"Newsreader",Georgia,serif;font-size:17px;line-height:1.55}
  a{color:var(--signal)}
  .band{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);margin:26px 0}
  .cell{background:var(--ink);padding:18px}
  .cell .n{font-family:"Spline Sans Mono",monospace;font-size:26px;color:var(--bright)}
  .cell .n.g{color:var(--signal)}
  .cell .k{font-size:13px;color:var(--dim);margin-top:6px}
  @media(max-width:760px){.band{grid-template-columns:repeat(2,1fr)}}
  .tools{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:20px 0 10px}
  input.f{flex:1;min-width:200px;background:var(--panel);border:1px solid var(--line);color:var(--fg);font-family:"Spline Sans Mono",monospace;font-size:13px;padding:10px 12px;outline:none}
  input.f:focus{border-color:var(--signal)}
  table{width:100%;border-collapse:collapse;font-family:"Spline Sans Mono",monospace;font-size:12.5px}
  th,td{text-align:left;padding:8px 9px;border-bottom:1px solid var(--line);white-space:nowrap}
  th{position:sticky;top:0;background:#0f1214;color:var(--dim);font-weight:500;font-size:11px;letter-spacing:.06em;text-transform:uppercase}
  td.dom{color:var(--bright)}
  .v-blocked{color:var(--red)}.v-allowed{color:var(--signal)}.v-partial{color:var(--amber)}.v-unlisted{color:var(--dim)}
  .scroll{overflow:auto;max-height:70vh;border:1px solid var(--line)}
  .cta{margin:30px 0 60px;background:var(--panel);border:1px solid rgba(60,240,138,.4);padding:24px}
  .cta h2{font-size:22px;color:var(--bright);margin:0 0 8px;font-weight:500}
</style>
<link rel="stylesheet" href="/theme.css">
</head>
<body class="prose">
<div class="masthead"><div class="wrap">
  <a class="mark" href="/">The Crawl Price Index<b>.</b></a>
  <nav>
    <a class="lnk" href="/check">Check a domain</a>
    <a class="lnk" href="/why">Why it matters</a>
    <a class="lnk" href="/world">World editions</a>
    <a class="lnk" href="/methodology">Methodology</a>
    <a class="ghost" href="https://app.crawlpriceindex.com">Free dashboard</a>
    <a class="btn" href="https://app.crawlpriceindex.com/dashboard.html#account">Get the Terminal</a>
  </nav>
</div></div>
<div class="page-open"><div class="wrap">
  <div class="eyebrow">The Crawl Price Index · free sample</div>
  <h1>Who blocks which AI crawler.</h1>
  <div class="meta" id="meta">loading…</div>
</div></div>
<div class="wrap">
  <div class="band" id="band"></div>
  <div class="tools">
    <input class="f" id="filter" placeholder="filter by domain…">
    <span class="note" id="count"></span>
    <a class="note" id="raw" href="#" style="margin-left:auto">raw JSON →</a>
  </div>
  <div class="scroll"><table><thead id="thead"></thead><tbody id="tbody"></tbody></table></div>
  <div class="cta">
    <h2>This is the top 100. The Terminal has every domain.</h2>
    <div>Full per-domain dataset, all country editions, weekly history, and the JSON/CSV API — updated every week.</div>
    <a class="btn" href="https://crawlpriceindex.com/#access">Unlock the Terminal — €79/mo →</a>
    <div class="note">Sample free to evaluate with attribution · full dataset is single-subscriber licensed</div>
  </div>
</div>
<script>
(async function(){
  const p = new URLSearchParams(location.search);
  const e = p.get('e'), t = p.get('t');
  const meta = document.getElementById('meta');
  if (!e || !t) { meta.textContent = 'This link is missing its access token — please use the link from your welcome email.'; return; }
  const api = 'https://api.crawlpriceindex.com/v1/sample?e=' + encodeURIComponent(e) + '&t=' + encodeURIComponent(t);
  document.getElementById('raw').href = api;
  let d;
  try {
    const r = await fetch(api);
    d = await r.json();
    if (d.error) { meta.textContent = d.error; return; }
  } catch (err) { meta.textContent = 'Could not load the sample — try the raw link.'; return; }
  const rows = d.per_domain_sample || [];
  meta.textContent = 'Generated ' + (d.generated_utc || '').slice(0,10) + ' · ' + (d.coverage ? d.coverage.robots_parsed.toLocaleString() + ' domains parsed of the Tranco top ' + d.coverage.tranco_top_n.toLocaleString() : '');
  const br = d.block_rates || {};
  const top = Object.entries(br).sort((a,b)=>b[1].rate_pct-a[1].rate_pct).slice(0,4);
  document.getElementById('band').innerHTML = top.map(function(x){
    return '<div class="cell"><div class="n g">' + x[1].rate_pct + '%</div><div class="k">of the scanned web blocks ' + x[0] + ' in robots.txt</div></div>';
  }).join('');
  const cols = rows.length ? Object.keys(rows[0]) : [];
  document.getElementById('thead').innerHTML = '<tr>' + cols.map(function(c){ return '<th>' + c + '</th>'; }).join('') + '</tr>';
  function render(list){
    document.getElementById('tbody').innerHTML = list.map(function(r){
      return '<tr>' + cols.map(function(c){
        const v = r[c] == null ? '' : String(r[c]);
        const cls = ['blocked','allowed','partial','unlisted'].indexOf(v) >= 0 ? ' class="v-' + v + '"' : (c === 'domain' ? ' class="dom"' : '');
        return '<td' + cls + '>' + v + '</td>';
      }).join('') + '</tr>';
    }).join('');
    document.getElementById('count').textContent = list.length + ' of ' + rows.length + ' rows';
  }
  render(rows);
  document.getElementById('filter').addEventListener('input', function(ev){
    const q = ev.target.value.trim().toLowerCase();
    render(q ? rows.filter(function(r){ return (r.domain||'').toLowerCase().indexOf(q) >= 0; }) : rows);
  });
})();
</script>
</body>
</html>
